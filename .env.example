# Uygulamanın internetteki adresi (maillerdeki linkler bununla oluşur)
BASE_URL=https://anket.firmaniz.com.tr
PORT=3000

# Veritabanı ve görsellerin saklanacağı klasör (sunucuda kalıcı disk olmalı)
DATA_DIR=./data

# İsteğe bağlı: yalnızca bu kodu bilenler hesap açabilsin
REGISTRATION_CODE=

# Admin kullanıcıların e-postaları (test linkini yalnızca onlar görür)
ADMIN_EMAILS=

# Kullanıcı adları bu alan adına çevrilir (alihakan.baykal -> alihakan.baykal@lcwaikiki.com)
COMPANY_DOMAIN=lcwaikiki.com

# İsteğe bağlı: yedeklerin diskten bağımsız kopyası için S3 uyumlu depolama (Railway bucket)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# İsteğe bağlı: İngilizce anketlerde DeepL ile çeviri (ücretsiz anahtarlar ':fx' ile biter).
# Boşsa geçici olarak Google Çeviri kullanılır.
DEEPL_API_KEY=
